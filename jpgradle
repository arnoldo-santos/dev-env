#!/usr/bin/env bash
# file = jpgradle

set -euo pipefail

function die() {
    echo "Error: $*" >&2
    exit 1
}

[[ -z "${1:-}" ]] && die "Usage: $0 <project-directory>"

PROJECT_DIR="$1"
PROJECT_NAME="$(basename "$PROJECT_DIR")"

# ── Ensure jq (Debian/Ubuntu only) ─────────────────────────────────────
function ensure_jq() {
    if command -v jq >/dev/null 2>&1; then
        echo "jq already installed"
        return 0
    fi
    echo "jq not found → installing..."
    if command -v apt-get >/dev/null 2>&1 || command -v apt >/dev/null 2>&1; then
        sudo apt-get update -qq || sudo apt update -qq
        sudo apt-get install -y jq || sudo apt install -y jq
        echo "jq installed"
        return 0
    else
        echo "No apt → cannot auto-install jq"
        return 1
    fi
}

# ── Detect Java ───────────────────────────────────────────────────────
command -v java >/dev/null || die "Java not in PATH"
JAVA_VERSION_FULL=$(java --version 2>&1 | head -n1)
if [[ $JAVA_VERSION_FULL =~ openjdk[[:space:]]([0-9]+) ]]; then
    JAVA_MAJOR="${BASH_REMATCH[1]}"
else
    die "Cannot parse Java version from: $JAVA_VERSION_FULL"
fi
echo "Detected Java $JAVA_MAJOR"

# ── Detect Gradle ───────────────────────────────────────────────────
command -v gradle >/dev/null || die "Gradle not in PATH"
GRADLE_VERSION=$(gradle --version | awk '/^Gradle /{print $2}')
echo "Detected Gradle $GRADLE_VERSION"

# ── Get latest stable JUnit Jupiter (ultra-safe) ─────────────────────
JUNIT_VERSION="5.11.4" # safe fallback – Dec 2025

if command -v curl >/dev/null 2>&1 && ensure_jq; then
    echo "Fetching latest JUnit Jupiter version from Maven Central..."
    if response=$(curl --fail -sS "https://search.maven.org/solrsearch/select?q=g:org.junit.jupiter+a:junit-jupiter-api&rows=1&wt=json"); then
        if [[ -n "$response" ]] && VERSION=$(echo "$response" | jq -r '.response.docs[0].latestVersion // empty'); then
            if [[ -n "$VERSION" && "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                JUNIT_VERSION="$VERSION"
                echo "Using latest JUnit Jupiter $JUNIT_VERSION"
            fi
        fi
    fi
fi
echo "JUnit Jupiter version → $JUNIT_VERSION"

# ── Create project ───────────────────────────────────────────────────
mkdir -p "$PROJECT_DIR"
cd "$PROJECT_DIR"

# default DSL = --dsl groovy
gradle init --type basic --project-name "$PROJECT_NAME" >/dev/null <<EOF
y
EOF

cat >settings.gradle.kts <<EOF
rootProject.name = "$PROJECT_NAME"
EOF

#── Replace the default empty build.gradle.kts with a proper Groovy build.gradle ──
if [ -f build.gradle.kts ]; then
    echo "Replacing default build.gradle.kts with proper Groovy build.gradle"
    rm -f build.gradle.kts
fi

# ── Create build.gradle (Groovy DSL) ─────────────────────────────────────
cat >build.gradle <<EOF
plugins {
    id 'java'
    id 'application'
}

java {
    sourceCompatibility = JavaVersion.VERSION_$JAVA_MAJOR
    targetCompatibility = JavaVersion.VERSION_$JAVA_MAJOR
}

application {
    mainClass = 'Main'
}

// THIS LINE IS THE ONLY ONE YOU NEED — WORKS PERFECTLY IN GROOVY
tasks.run.standardInput = System.in

repositories {
    mavenCentral()
}

dependencies {
    testImplementation 'org.junit.jupiter:junit-jupiter-api:$JUNIT_VERSION'
    testRuntimeOnly 'org.junit.jupiter:junit-jupiter-engine:$JUNIT_VERSION'
    testRuntimeOnly 'org.junit.platform:junit-platform-launcher'
}

test {
    useJUnitPlatform()
}

sourceSets {
    main {
        java.srcDirs = ['src']
        resources.srcDirs = ['src']
    }
    test {
        java.srcDirs = ['test']
        resources.srcDirs = ['test']
    }
}
EOF

mkdir -p src test

cat >src/Main.java <<'EOF'
public class Main {
    public static void main(String[] args) {
        System.out.println("Hello from <%= projectName %>!");
    }
}
EOF

cat >test/MainTest.java <<'EOF'
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class MainTest {
    @Test void forever() { assertTrue(true); }
}
EOF

# ── Gradle Wrapper ───────────────────────────────────────────────────
gradle wrapper --gradle-version "$GRADLE_VERSION" --distribution-type bin >/dev/null
chmod +x gradlew 2>/dev/null || true

# # ── helper scripts──
cat >run <<'EOF'
#!/usr/bin/env bash
# Clean & silent run – no Gradle progress bar ever
set -euo pipefail
./gradlew --quiet run "$@" | cat
EOF

cat >compile <<'EOF'
#!/usr/bin/env bash
# Normal build (you still want to see warnings/errors)
set -euo pipefail
./gradlew build "$@"
EOF

cat >check <<'EOF'
#!/usr/bin/env bash
# Clean test runner
set -euo pipefail
./gradlew --quiet test "$@"
EOF

chmod +x run compile check

# ── Final message ─────────────────────────────────────────────────────
echo ""
echo "Project created: $PROJECT_NAME"
echo "   Java $JAVA_MAJOR  •  Gradle $GRADLE_VERSION  •  JUnit $JUNIT_VERSION"
echo ""
echo "   cd \"$PROJECT_DIR\""
echo ""
echo "   Useful commands:"
echo "     ./run        → super clean run (no Gradle noise)"
echo "     ./compile    → normal build with full output"
echo "     ./check      → clean test run"
echo "     ./gradlew …  → if you ever need the raw thing"
echo ""
echo "Enjoy!"
