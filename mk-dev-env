#!/bin/bash
# file = mk-dev-env.sh

# set strict mode
set -euo pipefail
# root directory
ROOT_DIR="$HOME/software/scripts"
# import
source "${ROOT_DIR}"/tool/std.sh

# check internet connectivity
function check_internet_connection() {
    if ping -c 1 -W 3 8.8.8.8 &>/dev/null; then
        echo "✓ internet connection OK"
        return "$OK"
    fi
    print_error "✗ No internet connection"
    return "$ERROR"
}

function make_dev_env() {

    # install essential software
    bash "$ROOT_DIR"/dev-env/install-all.sh || return "$ERROR"

    # build software
    bash "$ROOT_DIR"/dev-env/build-all.sh || return "$ERROR"

    print_success "Development Environment successfull!"
    return "$OK"
}

function run() {
    check_internet_connection || exit "$ERROR"
    make_dev_env && sudo reboot
}

run
